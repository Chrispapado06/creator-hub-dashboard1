# Copy to .env and fill in (or just `export` these in your shell). All optional —
# the app also reads these from the Settings tab and stores them in credentials.json.

# APP_PASSWORD=...          # set to require a login
# ONLYFANS_API_KEY=...      # live OnlyFans tracking-link data
# SUPABASE_URL=...          # live data mirror (optional)
# SUPABASE_ANON_KEY=...
# META_TOKEN=...            # Meta spend join (optional)
# META_AD_ACCT=...          # without the act_ prefix
# AMPLITUDE_MCP_TOKEN=...   # optional Amplitude MCP token
