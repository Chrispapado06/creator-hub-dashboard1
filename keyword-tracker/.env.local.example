# OnlyFans API (https://app.onlyfansapi.com). Server-side only — never exposed
# to the browser. The existing dashboard authenticates with a Bearer token, so
# this is that same key.
ONLYFANS_API_KEY=

# Supabase — point this at the SAME project the main dashboard uses so this app
# reads the existing `creators` table.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only. Used by server actions to write to the DB,
# bypassing RLS. Never prefix this with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
