# --- Required ---

# From @BotFather on Telegram (run /newbot).
TELEGRAM_BOT_TOKEN=123456789:AA-your-bot-token-here

# Your numeric chat id. Message your bot once, then run: npm run get-chat-id
TELEGRAM_CHAT_ID=

# --- Optional (sensible defaults shown) ---

# IANA timezone used for both the clock and the daily reminder time.
TZ=Europe/Nicosia

# When to send the daily reminder (cron, evaluated in TZ above). Default 9:00 AM.
DAILY_CRON=0 9 * * *

# Weekday on which the "check payout requests" digest is appended.
WEEKLY_DIGEST_DAY=Monday

# Override the creators.json location (defaults to src/creators.json).
# DATA_FILE=/app/src/creators.json
