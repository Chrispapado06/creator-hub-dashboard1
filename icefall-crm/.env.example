# The variable is VITE_SUPABASE_PUBLISHABLE_KEY, not ..._ANON_KEY.
# The wrong name fails silently rather than erroring.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# The aeroplane demo. `1` builds the CRM with NO Supabase client, no network of
# any kind, and every screen populated from the invented fixtures in
# src/offline/. Auth is bypassed and a permanent banner says the data is not
# real. Anything else — including leaving this line out — is the real CRM.
#
#   VITE_ICEFALL_OFFLINE=1 npm run dev
#
# VITE_ICEFALL_OFFLINE=1
