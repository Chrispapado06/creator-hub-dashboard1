# ICEFALL travel API — secrets live here, on the SERVER only. Never in the app bundle.
# Copy this file to `server/.env` and fill in the keys you have. Any key you
# leave blank simply stays "not connected" and the app uses its demo data.

# --- Flights: Duffel (https://app.duffel.com) -------------------------------
# Test tokens start with "duffel_test_", live tokens "duffel_live_".
# Start with a test token — search works in test mode.
DUFFEL_API_KEY=
# Duffel API version to send in the Duffel-Version header (see their changelog).
DUFFEL_VERSION=v2

# --- Hotels: LiteAPI / Nuitée (https://dashboard.liteapi.travel) ------------
# Use your sandbox key first (works against the production-mirroring sandbox).
LITEAPI_KEY=

# --- Waitlist: Supabase (see ../WAITLIST.md) ---------------------------------
# Leave these blank in development and signups append to server/.data/waitlist.jsonl,
# which is enough to test the form end to end. Set them and the same code writes
# to the real table instead — the store is the only thing that changes.
#
# USE THE PUBLISHABLE (anon) KEY, NEVER THE SERVICE-ROLE KEY. The waitlist table
# is insert-only to anon with no SELECT policy, so a leaked publishable key can
# add rows and cannot read anyone's email address. A service-role key could read
# every row in the database and buys nothing here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- Oura Ring: health measurements -----------------------------------------
# EVERY VARIABLE BELOW IS A SERVER SECRET. None of them may be given a VITE_
# prefix, put in .env.local, or referenced from icefall-app: Vite compiles VITE_
# variables into the browser bundle, so a "VITE_OURA_CLIENT_SECRET" would be
# published to every visitor the moment it was built.
#
# Leave them blank and /api/health reports which one is missing by name; the
# Oura endpoints answer 503 "not_configured" and no screen pretends otherwise.
#
# Register the application at https://cloud.ouraring.com/oauth/applications
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=

# The OAuth redirect. Must be the SAME STRING here and in the Oura application's
# redirect-URI list — Oura matches it exactly, down to the trailing slash.
#   production   https://icefall.app/api/oura/callback
#   development  the https tunnel in front of this port, + /api/oura/callback
OURA_REDIRECT_URI=

# Where the browser is sent after the callback. A COMMA-SEPARATED ALLOWLIST, and
# the only destinations that can ever be used: a redirect target the caller can
# choose is an open redirect, and this one sits at the end of an OAuth flow.
# The first entry is the default when the caller names none.
# The native app's universal link or custom scheme is added here, not in code.
OURA_APP_RETURN_URLS=https://icefall.app/settings/health

# Signs the OAuth `state`. Any random string of 32+ characters, e.g.
#   openssl rand -base64 48
# Changing it invalidates any authorize link issued in the last ten minutes and
# nothing else.
OURA_STATE_SECRET=

# Seals the stored Oura tokens (AES-256-GCM). EXACTLY 32 BYTES, as 64 hex
# characters or 44 base64 characters:
#   openssl rand -hex 32
# LOSING OR CHANGING THIS DOES NOT LOSE ANY HEALTH DATA — the measurements are
# stored as ordinary columns. It makes the stored tokens unreadable, so every
# connected person has to reconnect their ring. Back it up somewhere real.
OURA_TOKEN_KEY=

# Echoed back during Oura's webhook verification handshake, and checked on the
# way in so a stranger cannot have their own Oura application verified against
# our callback. Any random string; the same value goes to
# `node server/oura-subscriptions.mjs create`.
OURA_WEBHOOK_VERIFICATION_TOKEN=

# The public HTTPS callback Oura posts events to. Used by the subscription
# command only — the endpoint itself does not need to know its own address.
#   production   https://icefall.app/api/oura/webhook
#   development  the https tunnel + /api/oura/webhook  (localhost cannot work:
#                Oura verifies the URL from their servers, not from this one)
OURA_WEBHOOK_URL=

# Supabase's JWT secret — Dashboard → Project Settings → API → JWT Settings.
# Used to mint a 60-second token naming the `oura_service` database role, which
# the migration grants EXECUTE on the Oura functions and nothing else.
#
# WHY NOT THE SERVICE-ROLE KEY: it is every table in the project with RLS off.
# This feature needs nine. A leak of this environment should cost the Oura
# tables, not the waitlist, the enquiries and everybody's profile.
SUPABASE_JWT_SECRET=

# Optional. Days of history fetched when somebody first connects (default 30,
# max 365).
OURA_BACKFILL_DAYS=

# Optional. How old the newest reading may be before the app is told there is no
# recent data (default 2). Two rather than one because Oura's sleep and
# readiness only reach their cloud when the person opens the Oura app.
OURA_FRESHNESS_DAYS=

# Optional. Overrides the requested scopes. Exists because ONE SCOPE STRING IS
# GENUINELY DISPUTED between two live Oura sources — their HTML docs say `spo2`,
# their OpenAPI document says `spo2Daily` — and it is settled by trying it
# against the authorize endpoint, not by reading harder. Default:
#   personal daily heartrate workout session spo2
OURA_SCOPES=

# --- Server ------------------------------------------------------------------
# Port the API listens on. Vite proxies /api here (see vite.config.ts).
# API_PORT wins over PORT: `npm run dev:all` starts this process next to Vite,
# and whatever launches the pair often exports PORT meaning the *web* server.
API_PORT=8788
