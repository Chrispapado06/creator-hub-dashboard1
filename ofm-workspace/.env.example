# ─────────────────────────────────────────────────────────────────────────────
# OFM Workspace — client environment
# Copy this file to `.env` and fill in your Supabase project's values.
#
# ONLY public / client-safe keys belong in this file. The Supabase
# service_role key must NEVER live here (or anywhere in the desktop client) —
# it is set as a Supabase Edge Function secret instead. See README.
# ─────────────────────────────────────────────────────────────────────────────

# Your Supabase project URL, e.g. https://abcdefghijkl.supabase.co
# Dashboard → Project Settings → API → Project URL
VITE_SUPABASE_URL=

# Your Supabase publishable (a.k.a. "anon"/public) key — safe to ship in a client.
# Dashboard → Project Settings → API → Project API keys → `anon` / `publishable`
# (newer projects show this as the "publishable" key, format: sb_publishable_...)
VITE_SUPABASE_PUBLISHABLE_KEY=

# (Optional) Styled public-page viewer deployed on Vercel — see ofm-public-viewer/.
# When set, "Publish to web" links use this styled viewer; otherwise they fall
# back to the plain-text view served by Supabase.
VITE_PUBLIC_VIEWER_URL=
