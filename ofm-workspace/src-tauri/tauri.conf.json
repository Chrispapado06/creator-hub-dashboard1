{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OFM Workspace",
  "version": "0.1.0",
  "identifier": "com.christofispapadopoulos.ofm-workspace",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OFM Workspace",
        "width": 1280,
        "height": 832,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["ofm"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk3NkRDMTVBNjM4NjlCNUYKUldSZm00WmpXc0Z0bDdMbkJUdVVORFkxbVVpSUt5M0FDUC9SYVloVy8zb1FJVmxXb1hmZklWSnMK",
      "endpoints": [
        "https://github.com/Chrispapado06/creator-hub-dashboard1/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
