    "test:lake-louise": "esbuild src/trip/lakeLouise.test.ts --bundle --platform=node --format=esm --log-level=warning --define:import.meta.env={} --alias:@=./src --outfile=node_modules/.icefall-tests/lake-louise.test.mjs && node node_modules/.icefall-tests/lake-louise.test.mjs",
