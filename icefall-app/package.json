    "test:objective-debrief": "esbuild src/objectives/objectiveDebrief.test.ts --bundle --platform=node --format=esm --log-level=warning --define:import.meta.env={} --alias:@=./src --external:node:fs --external:node:path --outfile=node_modules/.icefall-tests/objective-debrief.test.mjs && node node_modules/.icefall-tests/objective-debrief.test.mjs",
